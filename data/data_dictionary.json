{
  "Channel": {
    "description": "Marketing distribution channel definition",
    "primary_key": "channel_id",
    "cardinality": {
      "Campaign": "1:N (One channel hosts multiple campaigns)",
      "WebSession": "1:N (One channel refers multiple web sessions)",
      "Touchpoint": "1:N (One channel delivers multiple touchpoints)"
    },
    "lifecycle_states": [
      "Active",
      "Archived"
    ],
    "fields": {
      "channel_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "CHN-###",
        "validation": "^CHN-\\d{3}$"
      },
      "channel_name": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Paid Search",
          "Paid Social",
          "Organic Search",
          "Email",
          "Display",
          "Events/Conferences",
          "Direct",
          "Referral"
        ]
      },
      "channel_type": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Inbound",
          "Outbound",
          "Organic",
          "Paid"
        ]
      },
      "is_paid": {
        "type": "boolean",
        "required": true
      },
      "created_at": {
        "type": "datetime",
        "required": true
      }
    }
  },
  "Audience": {
    "description": "Target audience segment definition",
    "primary_key": "audience_id",
    "cardinality": {
      "Campaign": "1:N (One audience segment targeted by multiple campaigns)"
    },
    "lifecycle_states": [
      "Active",
      "Inactive"
    ],
    "fields": {
      "audience_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "AUD-2026-######",
        "validation": "^AUD-2026-\\d{6}$"
      },
      "audience_name": {
        "type": "string",
        "required": true
      },
      "industry": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Technology",
          "Healthcare",
          "Financial Services",
          "Manufacturing",
          "Retail",
          "Education"
        ]
      },
      "tier": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Enterprise",
          "Mid-Market",
          "SMB"
        ]
      },
      "target_persona": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "CTO/VP Eng",
          "CMO/VP Mktg",
          "CFO/Finance",
          "Operations Lead",
          "Security Lead"
        ]
      },
      "created_at": {
        "type": "datetime",
        "required": true
      }
    }
  },
  "Campaign": {
    "description": "Marketing campaign master record with budget, channel, and timeframe",
    "primary_key": "campaign_id",
    "foreign_keys": {
      "channel_id": "Channel.channel_id (Required)",
      "audience_id": "Audience.audience_id (Required)"
    },
    "cardinality": {
      "Channel": "N:1 (Belongs to one channel)",
      "Audience": "N:1 (Targets one audience)",
      "Creative": "1:N (Comprises multiple creatives)",
      "Touchpoint": "1:N (Drives multiple touchpoints)",
      "CostRecord": "1:N (Incurs multiple cost line items)"
    },
    "lifecycle_states": [
      "Active",
      "Completed",
      "Paused"
    ],
    "effective_dates": "start_date to end_date (end_date >= start_date)",
    "fields": {
      "campaign_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "CMP-2026-######",
        "validation": "^CMP-2026-\\d{6}$"
      },
      "campaign_name": {
        "type": "string",
        "required": true
      },
      "channel_id": {
        "type": "string",
        "required": true
      },
      "audience_id": {
        "type": "string",
        "required": true
      },
      "budget": {
        "type": "float",
        "required": true,
        "unit": "currency",
        "min": 500.0
      },
      "currency": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "USD",
          "EUR",
          "GBP"
        ]
      },
      "status": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Active",
          "Completed",
          "Paused"
        ]
      },
      "start_date": {
        "type": "date",
        "required": true
      },
      "end_date": {
        "type": "date",
        "required": true,
        "rule": "end_date >= start_date"
      }
    }
  },
  "Creative": {
    "description": "Advertising creative or content asset tied to a campaign",
    "primary_key": "creative_id",
    "foreign_keys": {
      "campaign_id": "Campaign.campaign_id (Required)"
    },
    "cardinality": {
      "Campaign": "N:1 (Belongs to one campaign)",
      "Touchpoint": "1:N (Associated with multiple touchpoints, optional)"
    },
    "lifecycle_states": [
      "Draft",
      "Live",
      "Retired"
    ],
    "fields": {
      "creative_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "CRT-2026-######",
        "validation": "^CRT-2026-\\d{6}$"
      },
      "campaign_id": {
        "type": "string",
        "required": true
      },
      "asset_type": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Video",
          "Static Banner",
          "Whitepaper",
          "Webinar",
          "Text Ad",
          "Case Study"
        ]
      },
      "headline": {
        "type": "string",
        "required": true
      },
      "call_to_action": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Book Demo",
          "Download Now",
          "Start Free Trial",
          "Contact Sales",
          "Learn More"
        ]
      },
      "created_at": {
        "type": "datetime",
        "required": true
      }
    }
  },
  "Contact": {
    "description": "Prospective or existing customer master record",
    "primary_key": "contact_id",
    "cardinality": {
      "WebSession": "1:N (Executes multiple web sessions, optional)",
      "Touchpoint": "1:N (Participates in multiple touchpoints, mandatory)",
      "Lead": "1:N (Initiates leads)",
      "Opportunity": "1:N (Associated with multiple opportunities)",
      "Order": "1:N (Places multiple revenue orders)"
    },
    "lifecycle_states": [
      "Visitor",
      "Lead",
      "MQL",
      "SQL",
      "Opportunity",
      "Customer",
      "Churned"
    ],
    "lifecycle_transitions": {
      "Visitor": [
        "Lead"
      ],
      "Lead": [
        "MQL",
        "Churned"
      ],
      "MQL": [
        "SQL",
        "Lead",
        "Churned"
      ],
      "SQL": [
        "Opportunity",
        "MQL",
        "Churned"
      ],
      "Opportunity": [
        "Customer",
        "Churned"
      ],
      "Customer": [
        "Churned"
      ],
      "Churned": [
        "Lead"
      ]
    },
    "fields": {
      "contact_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "CNT-2026-######",
        "validation": "^CNT-2026-\\d{6}$"
      },
      "email": {
        "type": "string",
        "required": true,
        "unique": true
      },
      "first_name": {
        "type": "string",
        "required": true
      },
      "last_name": {
        "type": "string",
        "required": true
      },
      "company_name": {
        "type": "string",
        "required": true
      },
      "job_role": {
        "type": "string",
        "required": true
      },
      "lifecycle_stage": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Visitor",
          "Lead",
          "MQL",
          "SQL",
          "Opportunity",
          "Customer",
          "Churned"
        ]
      },
      "created_at": {
        "type": "datetime",
        "required": true
      }
    }
  },
  "WebSession": {
    "description": "Web traffic session event, either anonymous or linked to contact",
    "primary_key": "session_id",
    "foreign_keys": {
      "contact_id": "Contact.contact_id (Optional/Nullable)",
      "channel_id": "Channel.channel_id (Required)"
    },
    "cardinality": {
      "Contact": "N:1 (Optionally resolved to one contact via cookie)",
      "Channel": "N:1 (Originated from one channel)",
      "Touchpoint": "1:1 (May generate a digital touchpoint)"
    },
    "fields": {
      "session_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "SES-2026-######",
        "validation": "^SES-2026-\\d{6}$"
      },
      "cookie_id": {
        "type": "string",
        "required": true
      },
      "contact_id": {
        "type": "string",
        "required": false,
        "nullable": true
      },
      "channel_id": {
        "type": "string",
        "required": true
      },
      "landing_page": {
        "type": "string",
        "required": true
      },
      "page_views": {
        "type": "integer",
        "required": true,
        "min": 1
      },
      "duration_seconds": {
        "type": "integer",
        "required": true,
        "min": 0
      },
      "device_type": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Desktop",
          "Mobile",
          "Tablet"
        ]
      },
      "started_at": {
        "type": "datetime",
        "required": true
      },
      "ended_at": {
        "type": "datetime",
        "required": true,
        "rule": "ended_at >= started_at"
      }
    }
  },
  "Touchpoint": {
    "description": "Marketing interaction event across digital or offline touchpoints",
    "primary_key": "touchpoint_id",
    "foreign_keys": {
      "contact_id": "Contact.contact_id (Required)",
      "campaign_id": "Campaign.campaign_id (Required)",
      "channel_id": "Channel.channel_id (Required)",
      "creative_id": "Creative.creative_id (Optional)",
      "session_id": "WebSession.session_id (Optional)"
    },
    "cardinality": {
      "Contact": "N:1 (Belongs to one contact)",
      "Campaign": "N:1 (Belongs to one campaign)",
      "Channel": "N:1 (Belongs to one channel)",
      "AttributionResult": "1:N (Attributed across 5 models)"
    },
    "fields": {
      "touchpoint_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "TOUCH-<contact-id>-######",
        "validation": "^TOUCH-CNT-2026-\\d{6}-\\d{6}$"
      },
      "contact_id": {
        "type": "string",
        "required": true
      },
      "campaign_id": {
        "type": "string",
        "required": true
      },
      "channel_id": {
        "type": "string",
        "required": true
      },
      "creative_id": {
        "type": "string",
        "required": false,
        "nullable": true
      },
      "session_id": {
        "type": "string",
        "required": false,
        "nullable": true
      },
      "interaction_type": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Ad Click",
          "Email Open",
          "Email Click",
          "Content Download",
          "Webinar Attended",
          "Conference Meeting",
          "Product Demo",
          "Direct Visit"
        ]
      },
      "medium": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Online",
          "Offline"
        ]
      },
      "touchpoint_cost": {
        "type": "float",
        "required": true,
        "min": 0.0
      },
      "timestamp": {
        "type": "datetime",
        "required": true
      }
    }
  },
  "Lead": {
    "description": "Captured qualified marketing lead associated with a contact",
    "primary_key": "lead_id",
    "foreign_keys": {
      "contact_id": "Contact.contact_id (Required)",
      "first_touchpoint_id": "Touchpoint.touchpoint_id (Required)",
      "session_id": "WebSession.session_id (Optional)"
    },
    "cardinality": {
      "Contact": "N:1 (Belongs to one contact)",
      "Opportunity": "1:1 or 1:N (Converts to opportunities)"
    },
    "lifecycle_states": [
      "Open",
      "Contacted",
      "Qualified",
      "Unqualified",
      "Converted"
    ],
    "lifecycle_transitions": {
      "Open": [
        "Contacted",
        "Unqualified"
      ],
      "Contacted": [
        "Qualified",
        "Unqualified"
      ],
      "Qualified": [
        "Converted",
        "Unqualified"
      ],
      "Unqualified": [
        "Open"
      ],
      "Converted": []
    },
    "fields": {
      "lead_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "LEAD-2026-######",
        "validation": "^LEAD-2026-\\d{6}$"
      },
      "contact_id": {
        "type": "string",
        "required": true
      },
      "first_touchpoint_id": {
        "type": "string",
        "required": true
      },
      "session_id": {
        "type": "string",
        "required": false,
        "nullable": true
      },
      "lead_score": {
        "type": "integer",
        "required": true,
        "min": 0,
        "max": 100
      },
      "status": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Open",
          "Contacted",
          "Qualified",
          "Unqualified",
          "Converted"
        ]
      },
      "created_at": {
        "type": "datetime",
        "required": true
      }
    }
  },
  "Opportunity": {
    "description": "Sales pipeline deal progressing through stages to Won/Lost",
    "primary_key": "opportunity_id",
    "foreign_keys": {
      "contact_id": "Contact.contact_id (Required)",
      "lead_id": "Lead.lead_id (Required)"
    },
    "cardinality": {
      "Contact": "N:1 (Belongs to one contact)",
      "Lead": "N:1 (Converted from one lead)",
      "Order": "1:1 (Closed Won deal creates exactly one order)",
      "AttributionResult": "1:N (Attributed across 5 models)"
    },
    "lifecycle_states": [
      "Discovery",
      "Validation",
      "Proposal",
      "Negotiation",
      "Closed Won",
      "Closed Lost"
    ],
    "lifecycle_transitions": {
      "Discovery": [
        "Validation",
        "Closed Lost"
      ],
      "Validation": [
        "Proposal",
        "Closed Lost"
      ],
      "Proposal": [
        "Negotiation",
        "Closed Lost"
      ],
      "Negotiation": [
        "Closed Won",
        "Closed Lost"
      ],
      "Closed Won": [],
      "Closed Lost": []
    },
    "fields": {
      "opportunity_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "OPP-2026-######",
        "validation": "^OPP-2026-\\d{6}$"
      },
      "contact_id": {
        "type": "string",
        "required": true
      },
      "lead_id": {
        "type": "string",
        "required": true
      },
      "opportunity_name": {
        "type": "string",
        "required": true
      },
      "stage": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Discovery",
          "Validation",
          "Proposal",
          "Negotiation",
          "Closed Won",
          "Closed Lost"
        ]
      },
      "amount": {
        "type": "float",
        "required": true,
        "min": 0.0
      },
      "currency": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "USD",
          "EUR",
          "GBP"
        ]
      },
      "created_at": {
        "type": "datetime",
        "required": true
      },
      "closed_at": {
        "type": "datetime",
        "required": false,
        "nullable": true,
        "rule": "closed_at >= created_at"
      }
    }
  },
  "Order": {
    "description": "Closed revenue transaction linked to closed-won opportunity",
    "primary_key": "order_id",
    "foreign_keys": {
      "opportunity_id": "Opportunity.opportunity_id (Required, 1:1)",
      "contact_id": "Contact.contact_id (Required)"
    },
    "cardinality": {
      "Opportunity": "1:1 (Unique order per closed-won opportunity)",
      "Contact": "N:1 (Belongs to one customer contact)"
    },
    "lifecycle_states": [
      "Completed",
      "Refunded",
      "Processing"
    ],
    "fields": {
      "order_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "ORD-2026-######",
        "validation": "^ORD-2026-\\d{6}$"
      },
      "opportunity_id": {
        "type": "string",
        "required": true
      },
      "contact_id": {
        "type": "string",
        "required": true
      },
      "order_date": {
        "type": "datetime",
        "required": true
      },
      "gross_revenue": {
        "type": "float",
        "required": true,
        "min": 0.0
      },
      "currency": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "USD",
          "EUR",
          "GBP"
        ]
      },
      "status": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Completed",
          "Refunded",
          "Processing"
        ]
      }
    }
  },
  "CostRecord": {
    "description": "Direct financial spend record attributed to marketing campaigns",
    "primary_key": "cost_record_id",
    "foreign_keys": {
      "campaign_id": "Campaign.campaign_id (Required)",
      "channel_id": "Channel.channel_id (Required)"
    },
    "cardinality": {
      "Campaign": "N:1 (Belongs to one campaign)",
      "Channel": "N:1 (Belongs to one channel)"
    },
    "fields": {
      "cost_record_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "CST-2026-######",
        "validation": "^CST-2026-\\d{6}$"
      },
      "campaign_id": {
        "type": "string",
        "required": true
      },
      "channel_id": {
        "type": "string",
        "required": true
      },
      "spend_date": {
        "type": "date",
        "required": true
      },
      "spend_amount": {
        "type": "float",
        "required": true,
        "min": 0.0
      },
      "currency": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "USD",
          "EUR",
          "GBP"
        ]
      },
      "cost_category": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "Media Spend",
          "Agency Fee",
          "Software Tool",
          "Sponsorship",
          "Production"
        ]
      }
    }
  },
  "AttributionResult": {
    "description": "Calculated attribution weight, revenue, and ROI per touchpoint and model",
    "primary_key": "attribution_id",
    "foreign_keys": {
      "opportunity_id": "Opportunity.opportunity_id (Required)",
      "touchpoint_id": "Touchpoint.touchpoint_id (Required)",
      "campaign_id": "Campaign.campaign_id (Required)",
      "channel_id": "Channel.channel_id (Required)"
    },
    "cardinality": {
      "Opportunity": "N:1 (Belongs to one opportunity)",
      "Touchpoint": "N:1 (Attributed to one touchpoint)",
      "Campaign": "N:1 (Credited to one campaign)"
    },
    "fields": {
      "attribution_id": {
        "type": "string",
        "required": true,
        "unique": true,
        "format": "ATTR-2026-######",
        "validation": "^ATTR-2026-\\d{6}$"
      },
      "opportunity_id": {
        "type": "string",
        "required": true
      },
      "touchpoint_id": {
        "type": "string",
        "required": true
      },
      "campaign_id": {
        "type": "string",
        "required": true
      },
      "channel_id": {
        "type": "string",
        "required": true
      },
      "model_name": {
        "type": "string",
        "required": true,
        "allowed_values": [
          "First-Touch",
          "Last-Touch",
          "Linear",
          "U-Shaped",
          "Time-Decay"
        ]
      },
      "attribution_weight": {
        "type": "float",
        "required": true,
        "min": 0.0,
        "max": 1.0
      },
      "attributed_revenue_usd": {
        "type": "float",
        "required": true,
        "min": 0.0
      },
      "attributed_cost_usd": {
        "type": "float",
        "required": true,
        "min": 0.0
      },
      "calculated_at": {
        "type": "datetime",
        "required": true
      }
    }
  }
}